# Durable catalog cache. Leave these empty and the app uses ./data/cache on this machine.
# Production should be Cloudflare R2, or any other S3-compatible bucket.
CACHE_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
CACHE_S3_BUCKET=eronikki
CACHE_S3_REGION=auto
CACHE_S3_ACCESS_KEY_ID=
CACHE_S3_SECRET_ACCESS_KEY=

# Optional. Browser URL for Hitomi images, usually a Cloudflare Worker.
# Empty means this app streams them. Do that only for local reading.
NEXT_PUBLIC_HITOMI_IMAGE_BASE=

# Optional. Raises nhentai's shared cap. The cache is what keeps ordinary traffic under it.
NHENTAI_API_KEY=

# Hostname Caddy serves. Use the real domain in production, for example eronikki.example.com
SITE_ADDRESS=localhost
